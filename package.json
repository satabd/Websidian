{
  "name": "websidian",
  "version": "1.0.0",
  "description": "Websidian: your Obsidian vault as a website you can edit from anywhere. Markdown is rendered on request and cached until the .md file changes.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "skills": "node src/fetch-skills.js",
    "pack:openclaw": "node integrations/openclaw/websidian/deploy/pack.mjs",
    "dev": "node --watch src/server.js",
    "demo": "node -e \"process.env.WEBSIDIAN_CONFIG='demo/websidian.config.json';require('./src/server.js')\"",
    "test": "node --test \"test/**/*.test.js\" \"integrations/openclaw/websidian/test/*.test.js\""
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@excalidraw/excalidraw": "^0.17.6",
    "@highlightjs/cdn-assets": "^11.12.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.47",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^11.17.2",
    "minisearch": "^7.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
