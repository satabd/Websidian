{
  "name": "websidian",
  "version": "0.2.1",
  "description": "See what your OpenClaw agent remembers: a Memory page inside OpenClaw, its notes as a readable Obsidian-style website, and a guard so it can't quietly rewrite its own rules.",
  "type": "module",
  "license": "MIT",
  "files": ["index.js", "lib", "dist", "skills", "openclaw.plugin.json", "README.md"],
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.9"
  },
  "openclaw": {
    "extensions": ["./index.js"],
    "compat": {
      "pluginApi": ">=2026.6.9",
      "minGatewayVersion": "2026.6.9"
    },
    "build": {
      "openclawVersion": "2026.9.5",
      "pluginSdkVersion": "2026.9.5"
    }
  }
}
